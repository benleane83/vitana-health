<div class="product-scene" role="img" aria-label="Vitana dashboard showing synthetic wellness trends and recent health data">
  <div class="product-window">
    <div class="product-window__topbar">
      <div class="mini-brand">
        <img src="/brand/vitana-mark.svg" alt="" width="28" height="28" />
        <strong>Vitana</strong>
      </div>
      <div class="profile-chip"><span aria-hidden="true">S</span> Sam</div>
    </div>
    <div class="product-window__body">
      <aside class="mock-sidebar" aria-hidden="true">
        <span class="is-active">Overview</span>
        <span>Track</span>
        <span>Care</span>
        <span>Insights</span>
      </aside>
      <div class="mock-dashboard">
        <div class="mock-welcome">
          <div>
            <span class="mock-kicker">Good morning, Sam</span>
            <strong>See how your week is taking shape.</strong>
          </div>
          <span class="privacy-status"><i></i> Private on this device</span>
        </div>
        <div class="mock-summary">
          <section class="trend-panel">
            <div class="panel-heading">
              <div>
                <span>Resting heart rate</span>
                <strong>62 <small>bpm</small></strong>
              </div>
              <span class="quiet-chip">12 weeks</span>
            </div>
            <svg viewBox="0 0 560 180" aria-hidden="true" preserveAspectRatio="none">
              <defs>
                <linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#6751aa" stop-opacity="0.2" />
                  <stop offset="1" stop-color="#6751aa" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path class="chart-area" d="M0 118 C50 104 80 128 125 108 S206 62 250 78 S330 126 378 96 S450 48 560 58 L560 180 L0 180 Z" />
              <path class="chart-line" d="M0 118 C50 104 80 128 125 108 S206 62 250 78 S330 126 378 96 S450 48 560 58" />
              <circle cx="560" cy="58" r="7" />
            </svg>
            <div class="chart-labels"><span>May</span><span>June</span><span>July</span></div>
          </section>
          <section class="latest-panel">
            <div class="panel-heading">
              <span>Latest readings</span>
              <span class="fresh-label">Updated today</span>
            </div>
            <div class="reading-row"><span>Sleep</span><strong>7 h 42 min</strong><small>Health Connect</small></div>
            <div class="reading-row"><span>Steps</span><strong>8,246</strong><small>Health Connect</small></div>
            <div class="reading-row"><span>Weight</span><strong>72.4 kg</strong><small>Manual entry</small></div>
          </section>
        </div>
      </div>
    </div>
  </div>
  <div class="phone-window" aria-hidden="true">
    <div class="phone-window__notch"></div>
    <div class="phone-window__header">
      <img src="/brand/vitana-mark.svg" alt="" width="26" height="26" />
      <span>Sam</span>
    </div>
    <span class="phone-label">Today</span>
    <strong class="phone-title">Your health at a glance</strong>
    <div class="phone-reading phone-reading--seafoam"><span>Steps</span><strong>8,246</strong><small>Updated 4 min ago</small></div>
    <div class="phone-reading phone-reading--lavender"><span>Sleep</span><strong>7 h 42 min</strong><small>Last night</small></div>
    <div class="phone-tabs"><span>Today</span><span>Track</span><span>Sync</span></div>
  </div>
</div>