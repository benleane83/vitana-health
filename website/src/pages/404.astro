---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Page not found | Vitana Health"
  description="The requested Vitana Health page could not be found."
  noindex
>
  <section class="status-page">
    <div class="status-page__inner shell">
      <span class="legal-page__meta">404</span>
      <h1>This page is not part of the record.</h1>
      <p>The address may be outdated or incomplete.</p>
      <div class="status-page__actions">
        <a class="button" href="/">Return to Vitana</a>
      </div>
    </div>
  </section>
</SiteLayout>