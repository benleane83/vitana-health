---
import SiteLayout from "../layouts/SiteLayout.astro";

const comparisonRows = [
  { feature: "Core health record", detail: "Dashboard, measurements, journal, care, imports, and manual entry", free: "Included", pro: "Included" },
  { feature: "Profiles", detail: "Encrypted local records for people in your household", free: "One profile", pro: "Create additional profiles" },
  { feature: "Health insights", detail: "Get deeper insights into your health data", free: "Biological Age and AI Review", pro: "Biological Age, AI Review, and AI Query" },
  { feature: "Track views", detail: "Track trends across your health data", free: "Core tracking", pro: "Core tracking, Calendar, and Body Trend" },
  { feature: "Health Connect history", detail: "Sync from your Android app", free: "Up to 30 days", pro: "Up to 365 days" }
];
---

<SiteLayout
  title="Pricing | Vitana Health"
  description="Compare Vitana Free with the one-time Vitana Pro launch offer. Keep a private health record locally and unlock deeper trends when Pro launches."
>
  <section class="pricing-hero">
    <div class="shell pricing-hero__inner">
      <div class="pricing-hero__copy">
        <h1>Start free. Go deeper with Pro.</h1>
        <p>Vitana Free gives you your own private health workspace. Our Pro tier adds deeper trends, longer synced history, and room for more profiles.</p>
      </div>
      <aside class="pricing-hero__note" aria-label="Launch pricing note">
        <strong>$20 USD launch offer</strong>
        <span>One-time purchase, no subscription.</span>
        <small>Price may change after initial launch.</small>
      </aside>
    </div>
  </section>

  <section class="pricing-tiers" aria-labelledby="tiers-heading">
    <div class="shell">
      <h2 id="tiers-heading" class="visually-hidden">Vitana plans</h2>
      <div class="pricing-tiers__grid">
        <article class="tier-panel">
          <header class="tier-panel__header">
            <div>
              <h3>Vitana Free</h3>
              <p>Keep your health record on your own PC.</p>
            </div>
            <p class="tier-price"><strong>$0</strong><span>Free to use</span></p>
          </header>
          <ul class="tier-feature-list">
            <li>One encrypted local profile</li>
            <li>Sync 30 days of Health Connect history <span class="platform-label">Android</span></li>
            <li>Dashboard, measurements, care items, scans, and manual entry</li>
            <li>Biological Age and AI Review <span class="platform-label">PC</span></li>
            
          </ul>
          <a class="button button--secondary tier-panel__action" href="/#launch-updates">Get launch updates</a>
        </article>

        <article class="tier-panel tier-panel--pro">
          <header class="tier-panel__header">
            <div>
              <span class="tier-panel__label">Launch offer</span>
              <h3>Vitana Pro</h3>
              <p>Unlock the full picture with one purchase.</p>
            </div>
            <p class="tier-price"><strong>$20 <small>USD</small></strong><span>One time</span></p>
          </header>
          <p class="tier-panel__includes">Everything in Free, plus:</p>
          <ul class="tier-feature-list">
            <li>Create additional profiles</li>
            <li>Sync up to 365 days of Health Connect history <span class="platform-label">Android</span></li>
            <li>Calendar and Body Trend views <span class="platform-label">PC</span></li>
            <li>AI Query <span class="platform-label">PC</span></li>
          </ul>
          <a class="button tier-panel__action" href="/#launch-updates">Get launch updates</a>
        </article>
      </div>
      <p class="pricing-availability">Join the launch list and we will let you know when Vitana is available.</p>
    </div>
  </section>

  <section class="comparison-section" aria-labelledby="comparison-heading">
    <div class="shell">
      <div class="section-intro">
        <h2 id="comparison-heading">Compare the details.</h2>
        <p>Free keeps the essentials useful. Pro expands the parts designed for longer-term patterns and family use.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Vitana Free</th>
              <th scope="col">Vitana Pro</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr>
                <th scope="row">
                  <strong>{row.feature}</strong>
                  <span>{row.detail}</span>
                </th>
                <td data-label="Free">{row.free}</td>
                <td data-label="Vitana Pro">{row.pro}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="pricing-privacy" aria-labelledby="privacy-heading">
    <div class="shell pricing-privacy__inner">
      <div>
        <h2 id="privacy-heading">Your plan does not change your privacy.</h2>
        <p>Free and Pro use the same local-first foundation. Your health record stays encrypted by profile on your computer, without advertising or health-data cloud sync.</p>
      </div>
      <div class="pricing-privacy__facts" aria-label="Privacy commitments">
        <span>No subscription</span>
        <span>Encrypted local storage</span>
        <span>No health-data advertising</span>
      </div>
      <div class="pricing-privacy__links">
        <a class="text-link" href="/privacy">Read the privacy policy</a>
        <a class="text-link" href="/security">Review security</a>
      </div>
    </div>
  </section>

  <section class="pricing-notes" aria-labelledby="notes-heading">
    <div class="shell pricing-notes__inner">
      <div class="section-intro">
        <h2 id="notes-heading">Good to know before launch.</h2>
      </div>
      <div class="pricing-notes__list">
        <details>
          <summary>What does one-time purchase mean?</summary>
          <p>Vitana Pro is planned as a single purchase rather than a recurring subscription. The $20 USD price is a launch offer and may change after the initial release.</p>
        </details>
        <details>
          <summary>Can I buy Vitana Pro now?</summary>
          <p>Not yet. Vitana is still being prepared for public release. Join the launch list to hear when downloads and purchases become available.</p>
        </details>
        <details>
          <summary>What happens to existing profiles on Free?</summary>
          <p>Existing profiles remain available. Once plan limits are active, Free will limit creating additional profiles rather than hiding or deleting records you already have.</p>
        </details>
        <details>
          <summary>Which platforms are planned?</summary>
          <p>The PC app and Android companion are planned first. MacOS/iOS support may follow after the initial release.</p>
        </details>
      </div>
    </div>
  </section>
</SiteLayout>