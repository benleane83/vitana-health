{
  "name": "@vitana/desktop",
  "version": "0.1.7",
  "author": "Ben Leane",
  "description": "Packaged Vitana Health desktop application",
  "main": "main.cjs",
  "private": true,
  "vitanaDistributionChannel": "github",
  "vitanaUpdateChannel": "production",
  "dependencies": {
    "@vitana/api": "file:../api",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.15.3"
  },
  "scripts": {
    "prepackage": "npm run build -w packages/shared --prefix ../.. && node ../../scripts/prepare-duckdb-httpfs.mjs --output build/duckdb-extensions --skip-runtime-verification",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test *.test.cjs",
    "verify:native-abi": "electron verify-native-abi.cjs",
    "package": "npm run verify:native-abi && electron-builder --publish=never",
    "package:store": "npm run prepackage && npm run verify:native-abi && electron-builder --win appx --x64 --publish=never --config.directories.output=dist-store --config.extraMetadata.vitanaDistributionChannel=store"
  },
  "license": "Elastic-2.0",
  "type": "commonjs",
  "build": {
    "appId": "app.vitanahealth.desktop",
    "productName": "Vitana Health",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "main.cjs",
      "background-service.cjs",
      "background-service-settings.cjs",
      "secure-store-key.cjs",
      "startup-diagnostics.cjs",
      "desktop-updater.cjs",
      "user-data-migration.cjs",
      "pre-update-backup.cjs",
      "desktop-lifecycle.cjs",
      "build/*.ico",
      "package.json",
      "!**/node_modules/@vitana/api/data{,/**}",
      "!**/node_modules/@vitana/api/src{,/**}",
      "!**/node_modules/@vitana/api/{tsconfig.json,vitest.config.ts,vitest.durability.config.ts,vitest.integration.config.ts}",
      "!**/node_modules/duckdb/src{,/**}",
      "!**/node_modules/duckdb/test{,/**}",
      "!**/node_modules/duckdb/examples{,/**}",
      "!**/node_modules/duckdb/scripts{,/**}",
      "!**/node_modules/duckdb/.github{,/**}",
      "!**/node_modules/duckdb/{binding.gyp,binding.gyp.in,Makefile,tsconfig.json,vendor.py,.mocharc.json}"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/duckdb-extensions",
        "to": "duckdb-extensions"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": "nsis",
      "verifyUpdateCodeSignature": false
    },
    "appx": {
      "artifactName": "Vitana-Health-Store-Test-${version}.${ext}",
      "applicationId": "VitanaHealth",
      "identityName": "VitanaHealth.StoreTest",
      "publisher": "CN=Vitana Health Store Test",
      "publisherDisplayName": "Vitana Health",
      "displayName": "Vitana Health Store Test",
      "backgroundColor": "#ffffff",
      "capabilities": [
        "runFullTrust",
        "internetClientServer",
        "privateNetworkClientServer"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "benleane83",
        "repo": "vitana-health",
        "channel": "latest",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "Vitana-Health-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
