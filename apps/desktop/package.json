{
  "name": "@vitana/desktop",
  "version": "0.1.3",
  "author": "Ben Leane",
  "description": "Packaged Vitana Health desktop application",
  "main": "main.cjs",
  "private": true,
  "vitanaUpdateChannel": "production",
  "dependencies": {
    "@vitana/api": "file:../api",
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.13.0"
  },
  "scripts": {
    "prepackage": "node ../../scripts/prepare-duckdb-httpfs.mjs --output build/duckdb-extensions --skip-runtime-verification",
    "start": "electron .",
    "test": "node --test *.test.cjs",
    "package": "electron-builder --publish=never"
  },
  "license": "Elastic-2.0",
  "type": "commonjs",
  "build": {
    "appId": "app.vitanahealth.desktop",
    "productName": "Vitana Health",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "main.cjs",
      "background-service.cjs",
      "background-service-settings.cjs",
      "secure-store-key.cjs",
      "startup-diagnostics.cjs",
      "desktop-updater.cjs",
      "user-data-migration.cjs",
      "build/*.ico",
      "package.json",
      "!**/node_modules/duckdb/src{,/**}",
      "!**/node_modules/duckdb/test{,/**}",
      "!**/node_modules/duckdb/examples{,/**}",
      "!**/node_modules/duckdb/scripts{,/**}",
      "!**/node_modules/duckdb/.github{,/**}",
      "!**/node_modules/duckdb/{binding.gyp,binding.gyp.in,Makefile,tsconfig.json,vendor.py,.mocharc.json}"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/duckdb-extensions",
        "to": "duckdb-extensions"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": "nsis",
      "verifyUpdateCodeSignature": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "benleane83",
        "repo": "vitana-health",
        "channel": "latest",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "artifactName": "Vitana-Health-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
