{
  "name": "@local-fitness-advisor/desktop",
  "version": "0.1.0",
  "description": "Packaged Local Fitness Advisor desktop application",
  "main": "main.cjs",
  "private": true,
  "dependencies": {
    "@local-fitness-advisor/api": "file:../api"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.15.3"
  },
  "scripts": {
    "prepackage": "node ../../scripts/prepare-duckdb-httpfs.mjs --output build/duckdb-extensions --skip-runtime-verification",
    "start": "electron .",
    "test": "node --test secure-store-key.test.cjs startup-diagnostics.test.cjs package-config.test.cjs",
    "package": "electron-builder",
    "package:signed": "electron-builder --config.forceCodeSigning=true"
  },
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "build": {
    "appId": "com.localfitnessadvisor.desktop",
    "productName": "Local Fitness Advisor",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "main.cjs",
      "secure-store-key.cjs",
      "startup-diagnostics.cjs",
      "package.json",
      "!**/node_modules/duckdb/src{,/**}",
      "!**/node_modules/duckdb/test{,/**}",
      "!**/node_modules/duckdb/examples{,/**}",
      "!**/node_modules/duckdb/scripts{,/**}",
      "!**/node_modules/duckdb/.github{,/**}",
      "!**/node_modules/duckdb/{binding.gyp,binding.gyp.in,Makefile,tsconfig.json,vendor.py,.mocharc.json}"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/duckdb-extensions",
        "to": "duckdb-extensions"
      }
    ],
    "win": {
      "signtoolOptions": {
        "publisherName": "Local Fitness Advisor"
      },
      "target": "nsis",
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
