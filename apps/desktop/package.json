{
  "name": "@vitana/desktop",
  "version": "0.1.0",
  "description": "Packaged Vitana Health desktop application",
  "main": "main.cjs",
  "private": true,
  "dependencies": {
    "@vitana/api": "file:../api"
  },
  "devDependencies": {
    "electron": "43.1.0",
    "electron-builder": "26.15.3"
  },
  "scripts": {
    "prepackage": "node ../../scripts/prepare-duckdb-httpfs.mjs --output build/duckdb-extensions --skip-runtime-verification",
    "start": "electron .",
    "test": "node --test *.test.cjs",
    "package": "electron-builder",
    "package:signed": "electron-builder --config.forceCodeSigning=true"
  },
  "license": "Elastic-2.0",
  "type": "commonjs",
  "build": {
    "appId": "app.vitanahealth.desktop",
    "productName": "Vitana Health",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "main.cjs",
      "background-service.cjs",
      "background-service-settings.cjs",
      "secure-store-key.cjs",
      "startup-diagnostics.cjs",
      "user-data-migration.cjs",
      "build/*.ico",
      "package.json",
      "!**/node_modules/duckdb/src{,/**}",
      "!**/node_modules/duckdb/test{,/**}",
      "!**/node_modules/duckdb/examples{,/**}",
      "!**/node_modules/duckdb/scripts{,/**}",
      "!**/node_modules/duckdb/.github{,/**}",
      "!**/node_modules/duckdb/{binding.gyp,binding.gyp.in,Makefile,tsconfig.json,vendor.py,.mocharc.json}"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "build/duckdb-extensions",
        "to": "duckdb-extensions"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signtoolOptions": {
        "publisherName": "Vitana Health"
      },
      "target": "nsis",
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
