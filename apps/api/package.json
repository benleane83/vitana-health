    "express": "^4.21.2",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
