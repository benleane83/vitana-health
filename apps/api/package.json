{
  "name": "@local-fitness-advisor/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "predev": "npm run build -w @local-fitness-advisor/shared",
