{
  "name": "@vitana/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "predev": "npm run build -w @vitana/shared",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @vitana/shared",
    "test": "vitest run",
    "start": "node dist/server.js",
    "prepare:duckdb": "node ../../scripts/prepare-duckdb-httpfs.mjs --output ../desktop/build/duckdb-extensions"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitana/shared": "file:../../packages/shared",
    "cors": "^2.8.5",
    "duckdb": "^1.4.4",
    "express": "^4.21.2",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
