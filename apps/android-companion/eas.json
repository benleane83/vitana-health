{
  "cli": {
    "version": "20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "VITANA_ALLOW_CLEARTEXT": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "VITANA_ALLOW_CLEARTEXT": "0"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "VITANA_ALLOW_CLEARTEXT": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
