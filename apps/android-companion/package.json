{
  "name": "@vitana/android-companion",
  "version": "0.1.0",
  "license": "Elastic-2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "57.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@vitana/api-client": "^0.1.0",
    "expo": "~57.0.7",
    "expo-application": "~57.0.2",
    "expo-camera": "~57.0.1",
    "expo-crypto": "~57.0.0",
    "expo-health-connect": "^0.1.1",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-secure-store": "^57.0.0",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.6",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.0",
    "react-native-health-connect": "^3.5.3",
    "react-native-iap": "^14.7.20",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-build-properties": "^57.0.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "preview:web": "expo export --platform web --output-dir .expo-web-preview && node ../../scripts/serve-static.mjs .expo-web-preview 8082",
    "preview:web:demo": "node ../../scripts/preview-mobile-demo.mjs",
    "preview:web:health": "node ../../scripts/check-urls.mjs \"Mobile demo=http://127.0.0.1:8082\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "npm run build -w @vitana/shared && npm run build -w @vitana/api-client",
    "build:android:preview": "npx -y eas-cli@20.5.1 build --platform android --profile preview",
    "build:android:development": "npx -y eas-cli@20.5.1 build --platform android --profile development",
    "build:android:production": "npx -y eas-cli@20.5.1 build --platform android --profile production",
    "update:preview": "npx -y eas-cli@20.5.1 update --channel preview --environment preview",
    "update:production": "npx -y eas-cli@20.5.1 update --channel production --environment production"
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  },
  "private": true
}
