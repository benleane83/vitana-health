# Local Fitness Advisor — environment configuration template
# Copy this file to .env and fill in your values.
# Never commit your actual .env file.

# ─── Server ────────────────────────────────────────────────────────────────────
# TCP port the API server listens on (default: 4317)
PORT=4317

# Bind address; use 0.0.0.0 for LAN access, 127.0.0.1 for localhost only
HOST=127.0.0.1

# Node environment: development | production | test  (default: development)
NODE_ENV=development

# ─── Authentication ─────────────────────────────────────────────────────────────
# Shared secret for owner-level API access. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LFA_OWNER_TOKEN=

# Session secret used to sign pairing tokens. Must be ≥16 chars.
LFA_SECRET=

# ─── Data storage ───────────────────────────────────────────────────────────────
# Absolute path to the directory where the SQLite database is stored.
# Defaults to <repo-root>/data when not set.
LFA_DATA_DIR=

# ─── TLS (optional — recommended for LAN use) ──────────────────────────────────
# Paths to PEM-encoded certificate and private key files.
# If both are provided the server serves HTTPS; otherwise HTTP.
LFA_TLS_CERT=
LFA_TLS_KEY=

# ─── Web frontend static serving ───────────────────────────────────────────────
# Path to the built web app directory (apps/web/dist after `npm run build`).
# Leave empty in development — Vite dev server handles the frontend.
LFA_WEB_ROOT=

# ─── Development overrides ──────────────────────────────────────────────────────
# Allow plain HTTP even when on a non-loopback address (0 = off, 1 = allow)
# Never enable this in production.
LFA_ALLOW_INSECURE_HTTP=0

# ─── AI / Model runtime ─────────────────────────────────────────────────────────
# Which AI provider to use: ollama | openai
# LFA_MODEL_PROVIDER=ollama

# Base URL for Ollama when LFA_MODEL_PROVIDER=ollama (default: http://127.0.0.1:11434)
# LFA_OLLAMA_URL=http://127.0.0.1:11434

# Model name for Ollama (e.g. llama3, mistral). Defaults to the server default.
# LFA_MODEL_NAME=llama3

# OpenAI API key when LFA_MODEL_PROVIDER=openai
# LFA_OPENAI_API_KEY=sk-...

# Maximum time in milliseconds to wait for a model response (1000–300000)
# LFA_MODEL_TIMEOUT_MS=60000
